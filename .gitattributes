# Normalize text files to LF in the repository; Windows checkouts keep LF
# (editors and every toolchain in this repo handle LF on Windows fine).
* text=auto eol=lf

# Windows scripts keep their native endings.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries.
*.png binary
*.ico binary
*.exe binary
*.zip binary
*.woff binary
*.woff2 binary
